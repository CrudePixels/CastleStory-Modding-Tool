{
  "name": "castle-story-modding-tool",
  "version": "1.6.0",
  "description": "A comprehensive modding and multiplayer enhancement tool for Castle Story",
  "main": "src/main.js",
  "homepage": "https://github.com/CrudePixels/CastleStory-Modding-Tool",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "castle-story",
    "modding",
    "lua",
    "multiplayer",
    "lan",
    "game-tools"
  ],
  "author": "CrudePixels",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "com.crudepixels.castlestorymoddingtool",
    "productName": "Castle Story Modding Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "CastleStoryModdingTool_v${version}_Portable.exe"
    }
  }
}
